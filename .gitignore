# Python
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
*.pyc
__pycache__/

# SQLite local database
backend/projectpulse.db
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Environment variables / secrets
.env
.env.*
backend/.env
frontend/.env
frontend/.env.local

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code
.vscode/

# Operating System
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.coverage

# Temporary files
*.tmp
*.temp